    ex:priceEur 68.00 .

<http://example.org/mkr/flight/FL-7285> a ex:BudgetFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Vienna> ;
    ex:departsFrom <http://example.org/mkr/city/Warsaw> ;
    ex:departureDate "2026-04-22"^^xsd:date ;
    ex:durationMin 141 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Orbit_Airways> ;
    ex:priceEur 62.50 .

<http://example.org/mkr/flight/FL-7592> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Berlin> ;
    ex:departsFrom <http://example.org/mkr/city/Paris> ;
    ex:departureDate "2026-07-17"^^xsd:date ;
    ex:durationMin 292 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 212.99 .

<http://example.org/mkr/flight/FL-7880> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Krakow> ;
    ex:departsFrom <http://example.org/mkr/city/Madrid> ;
    ex:departureDate "2026-08-18"^^xsd:date ;
    ex:durationMin 267 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> ;
    ex:priceEur 245.00 .

<http://example.org/mkr/flight/FL-8760> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Tallinn> ;
    ex:departsFrom <http://example.org/mkr/city/Madrid> ;
    ex:departureDate "2026-07-18"^^xsd:date ;
    ex:durationMin 310 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 163.99 .

ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range ex:Source .

<http://example.org/mkr/stmt/FL-1242-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1242> .

<http://example.org/mkr/stmt/FL-1384-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-1384> .

<http://example.org/mkr/stmt/FL-2368-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/PassengerReport> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2368> .

<http://example.org/mkr/stmt/FL-3381-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-3381> .

<http://example.org/mkr/stmt/FL-4783-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-4783> .

<http://example.org/mkr/stmt/FL-6688-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 55 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6688> .

<http://example.org/mkr/stmt/FL-9100-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-9100> .

