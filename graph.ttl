@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Airline a rdfs:Class .

ex:BudgetFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:City a rdfs:Class .

ex:Country a rdfs:Class .

ex:Flight a rdfs:Class .

ex:LongFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:Source a rdfs:Class .

ex:arrivesAt a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departsFrom a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departureDate a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

<http://example.org/mkr/flight/FL-1471> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Oslo> ;
    ex:departsFrom <http://example.org/mkr/city/Tallinn> ;
    ex:departureDate "2026-06-18"^^xsd:date ;
    ex:durationMin 86 ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> ;
    ex:priceEur 204.00 .

<http://example.org/mkr/flight/FL-1903> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Rome> ;
    ex:departsFrom <http://example.org/mkr/city/Lviv> ;
    ex:departureDate "2026-09-18"^^xsd:date ;
    ex:durationMin 178 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> ;
    ex:priceEur 221.00 .

<http://example.org/mkr/flight/FL-2830> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Paris> ;
    ex:departsFrom <http://example.org/mkr/city/Munich> ;
    ex:departureDate "2026-06-09"^^xsd:date ;
    ex:durationMin 202 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/AeroVista> .

<http://example.org/mkr/flight/FL-3269> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
    ex:departsFrom <http://example.org/mkr/city/Berlin> ;
    ex:departureDate "2026-05-17"^^xsd:date ;
    ex:durationMin 256 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:priceEur 125.99 .

<http://example.org/mkr/flight/FL-3830> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Berlin> ;
    ex:departsFrom <http://example.org/mkr/city/Lyon> ;
    ex:departureDate "2026-03-20"^^xsd:date ;
    ex:durationMin 145 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Orbit_Airways> .

<http://example.org/mkr/flight/FL-6597> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Munich> ;
